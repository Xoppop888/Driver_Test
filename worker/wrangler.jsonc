{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "driveprep-access-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ORIGINS": "https://xoppop888.github.io",
    "SUPABASE_URL": "https://poiechqgfesrmuvcdnal.supabase.co"
  }
  // CI provides CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN as environment variables.
  // Runtime secrets are configured separately with `wrangler secret put`.
}
